+  // 仅place_data起手后的需求选位共识；不代替外层目标推进或奖励选择。
+  function selectSecondaryAgentDataSettlement(input = {}) {
+    if (input.currentAction?.family !== "place_data" || !input.origins?.length
+      || !input.legalSuccessors?.length || !input.legalSuccessors.every(action => (
+        action.family === "choose_target"
+        && ["computer", "blueBonus"].includes(action.target?.target)
+        && String(action.target?.choiceId || "").startsWith("data:")
+      ))) return null;
+    let choice = null;
+    let prunedChoiceCount = 0;
+    for (const origin of input.origins) {
+      const target = String(origin.routeTargetId || "");
+      if (origin.rootWasConditional || origin.goalCompletionPending
+        || !(target === DATA_ANALYZE_ROUTE_TARGET || target.startsWith("tech:gain:")
+          || (target.startsWith("income:gain:") && origin.routePlanId === "income:data:computer-slot-4"))) return null;
+      const selected = selectSecondaryAgentSuccessors({ ...input, ...origin,
+        actionChain: [...(origin.chain || []), input.currentAction.actionId],
+        focalProxyDepth: origin.proxyDepth || 0,
+      });
+      if (selected.length !== 1) return null;
+      const candidate = selected[0];
+      if (candidate.routeTargetId !== origin.routeTargetId
+        || candidate.routePlanId !== origin.routePlanId
+        || JSON.stringify(candidate.routeResultTargetIds || []) !== JSON.stringify(origin.routeResultTargetIds || [])
+        || (choice && choice.actionId !== candidate.actionId)) return null;
+      choice = candidate;
+      prunedChoiceCount += Number(candidate.targetEquivalentChoiceCount) || 0;
+    }
+    return { actionId: choice.actionId, prunedChoiceCount };
+  }
+
   function actionMatchesProbeStep(action, step) {
