+    // Route over the public board once, using the wallet as the
+    // reachability bound. Keep one minimum-cost path; never offer directions
+    // or payment combinations as independent search branches.
+    function walletEarthPath(state,cargo,capacity){
+      const {p,ship,from,earth}=cargo,query=rockets.createStaticCoordinateMoveQuery(state.pieces,ship.id);
+      const id=at=>at.x+":"+at.y,frontier=[{at:from,cost:0,path:[]}],seen=new Set();
+      while(frontier.length){
+        frontier.sort((a,b)=>a.cost-b.cost||a.path.length-b.path.length);
+        const {at,cost,path}=frontier.shift(),key=id(at);
+        if(seen.has(key))continue;
+        seen.add(key);
+        if(key===id(earth))return {path,cost};
+        const stepCost=rocketAbilities.getRequiredMovePointsFromCoordinate(state,p,at);
+        if(!Number.isSafeInteger(stepCost)||stepCost<1||cost+stepCost>capacity)continue;
+        for(const {deltaX,deltaY} of rocketAbilities.MOVE_DIRECTIONS){
+          const m=query(at,deltaX,deltaY);
+          if(!m.ok||seen.has(id(m.to)))continue;
+          frontier.push({at:m.to,cost:cost+stepCost,path:[...path,{from:at,to:m.to,deltaX,deltaY,cost:stepCost}]});
+        }
+      }
+      return null;
+    }
