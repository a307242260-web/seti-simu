+  // Last-round, already-spent Deep Space search: scoring ranks competing
+  // marks within one sector. Preserve ties, ownership, occupancy, board
+  // sequence and RNG. The saved state and its original scan order are untouched.
+  const scanOrderDataKeys=new WeakMap();
+  function scanOrderIdentityData(state){
+    if(state.turn?.roundNumber!==4||!state.match?.cardPlayContext?.lastScanNebulaId)return null;
+    const player=state.players.players.find(p=>p.id===state.turn.currentPlayerId);
+    if(!player?.mainActionCompleted||industryCatalog.getPlayerIndustryDefinition(player)?.activeAbilityId!=="deepspace_swap_cards"
+      ||Object.values(state.data.sectorExtraMarks||{}).some(marks=>marks.length))return null;
+    const board=state.data;
+    if(Object.isFrozen(board)&&scanOrderDataKeys.has(board))return scanOrderDataKeys.get(board);
+    const nebulae={...board.nebulae};
+    for(const [id,sector] of Object.entries(nebulae)){
+      const tokens=sector.tokens;
+      const sequence=tokens.map(t=>t.replacementOrder).filter(order=>order!=null);
+      if(sequence.some(order=>!Number.isSafeInteger(order)||order<1))return null;
+      if(!sequence.length)continue;
+      const ranks=new Map([...new Set(sequence)].sort((a,b)=>a-b).map((v,i)=>[v,i+1]));
+      nebulae[id]={...sector,tokens:tokens.map(t=>t.replacementOrder==null?t:{...t,replacementOrder:ranks.get(t.replacementOrder)})};
+    }
+    const result=freeze({...board,nebulae});
+    if(Object.isFrozen(board))scanOrderDataKeys.set(board,result);
+    return result;
+  }
