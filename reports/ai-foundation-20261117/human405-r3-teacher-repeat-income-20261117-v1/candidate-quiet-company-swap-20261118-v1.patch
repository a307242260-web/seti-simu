+const { createSeededRandom } = require("../random");
+const { buildRuleObservation } = require("../../app/rule-observation");
+const fixture = JSON.parse(z.gunzipSync(fs.readFileSync(path.join(__dirname,
+  "fixtures/quiet-company-swap-20261118-v1.json.gz"))));
+const seat = "player-white";
+const state = e => e.session?.session?.workingState || JSON.parse(e.committedState);
+function frozen(value) {
+  if (value && typeof value === "object" && !Object.isFrozen(value)) {
+    Object.values(value).forEach(frozen); Object.freeze(value);
+  }
+  return value;
+}
+function canonicalEnvelope(envelope) {
+  const id = envelope.session?.session?.sessionId;
+  const references = new Set(["sessionId", "effectId", "groupId", "parentEffectId", "decisionId"]);
+  return JSON.parse(JSON.stringify(envelope, (key, value) => key === "committedState" ? JSON.parse(value)
+    : id && references.has(key) && typeof value === "string" && (value===id||value.startsWith(id+":"))
+      ? "$session" + value.slice(id.length) : value));
+}
+for (const example of fixture.cases) {
+  const seed = state(example.before).meta.seed;
+  const kernel = createSimulationRuleComposition({seed, random:createSeededRandom(seed), activePlayerCount:4,
+    trustedProjectionReader:true, projectCounterfactualState:(s,v,c) => buildRuleObservation(s,seed,v?.playerId,[],
+      {cheap:v?.cheap===true,valueOnly:v?.valueOnly===true,trustedCommitted:c?.trustedCommitted===true})});
+  kernel.newGame({seed}); const comp=kernel.composition; assert(comp.lifecycle.restore(example.before).ok);
+  let fork;
+  const facade = {...comp, counterfactualPort:{...comp.counterfactualPort,
+    // The fixture is already a Native counterfactual world. Preserve that world
+    // to compare every protocol field, rather than re-sample its hidden deck.
+    prepareRoot:e=>e, createFork(...args) { const f=comp.counterfactualPort.createFork(...args); fork=f.composition||f; return f; }} };
+  const port=createAnalysisPort({composition:facade,seatId:seat,maxCacheEntries:0});
+  try {
+    const root=port.openRoot(); port.setCardPickPlanning(true); port.setResourcePlanning(true);
+    port.expand(root,example.steps[0].action.actionId);
