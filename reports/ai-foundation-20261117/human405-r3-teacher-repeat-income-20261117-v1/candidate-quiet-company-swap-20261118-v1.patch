+      assert.deepEqual(comp.lifecycle.save().envelope,example.before,"source and RNG must remain unchanged");
+    }
+    const d=port.getDiagnostics(); assert.equal(d.submissionCount,1);
+    assert.equal(d.provedCompanyStarts,1);assert.equal(d.provedCompanyHandMenus,1);assert.equal(d.provedCompanySwaps,1);
+  } finally { port.close();comp.dispose(); }
