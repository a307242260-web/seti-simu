+const first=fixture.cases[0], source=state(first.before), action=first.steps[0].action;
+for (const kind of ["earlier-round","other-owner","opponent-active","already-used","pass-pending","other-company","turn-bonus","empty-hand"]) {
+  const s=structuredClone(source), p=s.players.players.find(p=>p.id===seat);
