+  if(kind==="opponent-active")s.turn.passedPlayerIds=[];
+  if(kind==="already-used"){p.industryRoundMarkRound=4;p.industryRoundMarkTurn=s.turn.turnNumber;}
+  if(kind==="pass-pending")p.passCompletionPending=true;
+  if(kind==="other-company")p.initialSelection.industry.label="图灵系统";
